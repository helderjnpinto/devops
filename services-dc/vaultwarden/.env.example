# Vaultwarden — configuration
# Copy to .env and adjust:  cp .env.example .env

# Public URL of the service (HTTPS via Caddy)
DOMAIN=https://localhost:18443

# Admin token for the /admin panel
# Generate with: openssl rand -base64 48
ADMIN_TOKEN=

# Real-time sync (desktop/mobile clients)
WEBSOCKET_ENABLED=true

# Block public signup of new accounts
SIGNUPS_ALLOWED=false

# Timezone
TZ=Europe/Lisbon
